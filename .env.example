# Copy to backend/.env and fill in real values. NEVER commit .env.

# --- Backend ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# MongoDB Atlas (team leader shares the real string privately)
MONGODB_URI=<team-mongodb-atlas-connection-string>

# Auth
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=1h
# Optional (defaults: 7d, Secure cookies, lax, no domain).
# Cookies are Secure by default (ACC-19). Set COOKIE_SECURE=false only for
# plain-http local development; SameSite=none needs Secure cookies.
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# Set to true only when deployed behind a reverse proxy (real client IP for rate limits).
# TRUST_PROXY=true

# Image uploads (GEN-08). Optional: defaults are backend/uploads and
# http://localhost:<PORT>/uploads. At deployment point UPLOAD_DIR at a persistent disk.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_URL=http://localhost:3000/uploads

# Seeded administrator (used by the seed script)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>

# Stripe (test mode only)
STRIPE_SECRET_KEY=<sk_test_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>

# FXRatesAPI (backend only, never exposed to the frontend)
FXRATES_API_KEY=<fxrates-api-key>

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_...>
